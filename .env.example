# Copy to .env in the MAIN worktree root (e.g. ~/dev/hackclub/zach-mail-room/.env).
# Every worktree's `make` targets read that one file — see scripts/env-file.
# In production (Orchard) set these as deployment env vars instead; there is no .env file.

PORT=8080
# Public origin of the app. Hack Club Auth redirects to $BASE_URL/auth/callback,
# which must be registered on the OAuth app. In dev we go through the Vite server.
BASE_URL=http://localhost:5173
# Other origins you reach the app at; each /auth/callback must be registered too.
EXTRA_BASE_URLS=http://porygon:5173
DATABASE_URL=postgres://mailroom:mailroom@127.0.0.1:54329/mailroom?sslmode=disable
TEST_DATABASE_URL=postgres://mailroom:mailroom@127.0.0.1:54329/mailroom?sslmode=disable
# 32+ random chars: openssl rand -hex 32
SESSION_SECRET=

# Hack Club Auth (auth.hackclub.com)
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Supported: openid email name profile phone birthdate address verification_status slack_id legal_name basic_info
# HCA_SCOPES=openid email name slack_id verification_status address phone

# mail.hackclub.com (Theseus) warehouse API key
THESEUS_API_KEY=
# THESEUS_ORDER_TAG=zach-mail-room

# Airtable PAT with read access to the Unified YSWS Projects DB (app3A5kJwYqxMLOgh).
# Without it nobody is recognized as a YSWS author (admins still are).
AIRTABLE_API_KEY=

# Comma-separated admin emails
ADMIN_EMAILS=zach@hackclub.com

# HCB donation/payment page international requesters use to pay shipping.
# The app appends ?amount=<cents>&message=...
HCB_SHIPPING_PAYMENT_URL=
